{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "workspaceLayout": {
    "appsDir": "apps",
    "libsDir": "libs"
  },
  "namedInputs": {
    "sharedGlobals": [
      "{workspaceRoot}/tsconfig.server.json",
      "{workspaceRoot}/.oxlintrc.server.json",
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/bun.lock",
      "{workspaceRoot}/nx.json",
      "{workspaceRoot}/.node-version",
      "{workspaceRoot}/scripts/only-bun.mjs",
      "{workspaceRoot}/.github/actions/**/*",
      "{workspaceRoot}/.github/workflows/**/*",
      { "runtime": "node --version" },
      { "runtime": "bun --version" }
    ],
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/**/*.test.{ts,tsx}",
      "!{projectRoot}/src/test/**/*",
      "!{projectRoot}/src/test-setup.ts",
      "!{projectRoot}/scripts/**/*",
      "!{projectRoot}/bunfig.toml"
    ]
  },
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/dist"],
      "cache": true
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["default", "^production"],
      "cache": true
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["default", "^production"],
      "cache": true
    },
    "lint:ts": {
      "inputs": ["default"],
      "cache": true
    },
    "lint:css": {
      "inputs": ["default"],
      "cache": true
    },
    "format:check": {
      "inputs": ["default"],
      "cache": true
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "preview": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "test:e2e": {
      "cache": false
    },
    "test:e2e:tiers": {
      "cache": false
    },
    "refresh:libraries": {
      "cache": false
    }
  },
  "analytics": true
}
