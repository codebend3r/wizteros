TZ=America/New_York

# Host user that owns the bind-mounted data folders. On Synology, match this
# to the SSH user's `id` output (rarely 1000) so Wizarr/Tautulli can write.
PUID=1000
PGID=1000

STRIPE_API_KEY=sk_live_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

WIZARR_BASE_URL=http://wizarr:5690
WIZARR_API_KEY=replace_me
WIZARR_SERVER_IDS=all
INVITE_EXPIRES_DAYS=7
ACCESS_DURATION=35
MAP_DB_PATH=/data/bridge.db

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=replace_me
FROM_ADDR=server@example.com
PUBLIC_INVITE_BASE=https://invite.example.com

# Cloudflare Tunnel token (Zero Trust > Networks > Tunnels > your tunnel).
# Leave empty until the tunnel exists; cloudflared won't connect without it.
TUNNEL_TOKEN=replace_me
