# ===========================================================================
# Root .env: the two NestJS servers, plus the repo's local tooling
# ===========================================================================
#
# Copy this file to .env and fill it in. .env is gitignored; this template is
# committed, so it holds placeholders only, never a real key or address (the
# repository is public).
#
# Who reads it:
#   - docker-compose.yml passes the whole file (env_file) to stripe-bridge,
#     fleet-monitor and fleet-collector.
#   - The bridge's e2e and library-snapshot scripts load it with
#     `node --env-file`, and the .claude/skills scripts read it directly
#     (scripts/nas-host.sh for SSH targets, stack-health for public URLs).
#
# Where it lives:
#   - On your Mac, at the repo root, for local runs and the skills.
#   - On the NAS (Meleys), as its own copy beside the deployed compose file.
#     deploy-nas never copies this one there, so a change made here has to be
#     made on the NAS by hand, and the container recreated to pick it up.
#
# The admin portal's VITE_* variables do NOT go here: they live in
# apps/admin-portal/.env locally and in the Netlify dashboard for production.
#
# Sections, in order:
#   1. Shared container settings
#   2. stripe-bridge (Stripe, Wizarr, invites, email, Plex, admin auth, jobs)
#   3. fleet-monitor (admin auth, fleet hosts, play history)
#   4. Local tooling (skills and e2e scripts, never read by a container)
#
# Lines starting with "# NAME=" are optional; the value shown is the default
# the code uses while the variable is unset.


# ===========================================================================
# 1. Shared container settings
# ===========================================================================

# Timezone for every container. The bridge's baseline invite rotation fires
# at BASELINE_ROTATE_HOUR in this zone, so it decides what "03:00" means.
TZ=America/New_York

# Legacy: the user and group that own bind-mounted data folders. Nothing in
# this repo reads them any more; they date from when Wizarr and Tautulli were
# defined here. The NAS's own .env still carries them for its compose files.
# PUID=1000
# PGID=1000


# ===========================================================================
# 2. stripe-bridge
# ===========================================================================
# Turns Stripe webhooks into Wizarr invites, and serves the admin API behind
# the portal's /manage, /user and /reset-user pages. Listens on :8000; the
# Tailscale Funnel publishes it under /stripe.
#
# Required at boot (the bridge refuses to start without all of them):
#   STRIPE_API_KEY, STRIPE_WEBHOOK_SECRET, WIZARR_BASE_URL, WIZARR_API_KEY,
#   PUBLIC_INVITE_BASE, SMTP_HOST, SMTP_USER, SMTP_PASS

# --- 2a. Stripe -------------------------------------------------------------
# Secret API key (Stripe Dashboard > Developers > API keys). sk_test_... for
# test mode, sk_live_... for real payments.
STRIPE_API_KEY=sk_live_replace_me
# Signing secret of the webhook endpoint, used to verify every incoming event.
# Locally, `stripe listen` prints a whsec_... to use here instead.
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Optional. The customer portal login link (Stripe Settings > Billing >
# Customer portal), mailed to a member whose charge failed so they update the
# card instead of signing up again. Empty: no member mail.
BILLING_PORTAL_URL=

# --- 2b. Wizarr -------------------------------------------------------------
# Wizarr runs in the separate "westeroz" compose project, so use its
# host-published port on the NAS, not compose-network DNS.
WIZARR_BASE_URL=http://<meleys-ip>:5690
# Wizarr Settings > API keys.
WIZARR_API_KEY=replace_me

# --- 2c. Member invites and access ------------------------------------------
# Days a member's personal invite link stays redeemable. Wizarr honors an
# expiry of 1, 7 or 30 days and nothing else; any other number is snapped up
# to the next one of those (see wizarr.honored_expiry_days), so set one of
# them here or the window in force will not be the one written down.
INVITE_EXPIRES_DAYS=7
# Days of access one payment buys once the invite is redeemed. Slightly longer
# than a billing month, so a renewal lands before access lapses.
ACCESS_DURATION=35
# Public origin that members' invite links are built on
# (<base>/j/<code>). Set it to the Funnel address once that is up
# (docs/tailscale-funnel.md), e.g. https://<node>.<tailnet>.ts.net
PUBLIC_INVITE_BASE=https://invite.example.com

# --- 2d. Baseline invites ---------------------------------------------------
# The four per-tier signup links the bridge mints and rotates daily.
# Hour of the day (0 to 23, in TZ) the rotation runs.
BASELINE_ROTATE_HOUR=3
# How long each baseline link lives. Must stay above 1: at 1 the generations
# stop overlapping and a link shared just before the rotation dies almost at
# once. It also drives two different clocks, which only agree on 1, 7 and 30.
# The reaper deletes a link this many days after minting it, exactly; Wizarr's
# own expiry is snapped up to the next honored value, and is the backstop for
# a stretch where the bridge is not running to reap anything.
BASELINE_EXPIRES_DAYS=2

# --- 2e. Email --------------------------------------------------------------
# SMTP login the invite mails and operational alerts go out through.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=replace_me
# Sender address on every mail. Defaults to SMTP_USER while unset.
FROM_ADDR=server@example.com
# Where operational alarms (drift, failed renewals, standing-grant guards)
# are mailed, comma-separated. Falls back to ADMIN_ALLOWED_EMAILS.
# ALERT_EMAILS=

# --- 2f. Plex ---------------------------------------------------------------
# Plex owner token, used to ask plex.tv (not a server) who actually holds a
# share. This is ground truth for the admin pages, independent of what Wizarr
# thinks it granted, so leaving it unset silently degrades those checks.
# fleet-monitor reuses it for play history unless FM_PLEX_TOKEN is set.
PLEX_TOKEN=replace_me
# Base URL of plex.tv. Only ever changed to point a test at a fake.
# PLEX_TV_BASE=https://plex.tv

# --- 2g. Admin API auth -----------------------------------------------------
# The bridge verifies the caller's Supabase session (ES256 JWT checked against
# the project's JWKS) and requires an allowlisted email. SUPABASE_URL is the
# project URL; the JWKS and issuer derive from it.
SUPABASE_URL=https://<your-project-ref>.supabase.co
# Emails allowed through the admin API, comma-separated.
ADMIN_ALLOWED_EMAILS=you@example.com
# Browser origins allowed to call the admin API (CORS), comma-separated: the
# local Vite dev server and the deployed Netlify site.
ADMIN_ALLOWED_ORIGINS=http://localhost:5173,https://<your-netlify-site>.netlify.app

# --- 2h. Storage and background jobs ----------------------------------------
# SQLite file holding the customer map, tags, links and event log. /data is
# the container's mounted volume.
MAP_DB_PATH=/data/bridge.db
# Seconds between reconcile sweeps (drift alarms and the expiry sweep).
# RECONCILE_INTERVAL_SECONDS=3600
# Seconds between refreshes of the cached member list /admin/members serves.
# MEMBERS_SNAPSHOT_INTERVAL_SECONDS=300


# ===========================================================================
# 3. fleet-monitor
# ===========================================================================
# fleet-collector SSHes into all five NAS boxes and records host metrics,
# container state and Plex play history; fleet-monitor serves them to the
# portal's /fleet and /plays pages. Listens on :8010; the Tailscale Funnel
# publishes it under /monitor. Every variable here is prefixed FM_ because
# the monitor reads its own env, apart from the bridge's.

# --- 3a. Admin API auth -----------------------------------------------------
# Same Supabase project and allowlist as the bridge's SUPABASE_URL and
# ADMIN_ALLOWED_EMAILS. Leaving either blank does not open the API, it closes
# it: with the monitor published through the Funnel, half-configured has to
# mean shut.
FM_SUPABASE_URL=https://<project>.supabase.co
FM_ADMIN_ALLOWED_EMAILS=you@example.com

# --- 3b. Fleet hosts --------------------------------------------------------
# The unprivileged account the collector SSHes into all five hosts as.
# Required: the monitor refuses to boot without it.
FM_SSH_USER=
# The fleet's addresses, one list, in this order: meleys, vermithor, caraxes,
# syrax, vhagar. Required, exactly five IPv4 addresses; the monitor refuses to
# boot on anything else. scripts/nas-host.sh reads this same list (plus
# FM_SSH_USER) to build the NAS SSH target for every skill script.
FM_HOST_IPS=

# --- 3c. Play history -------------------------------------------------------
# Plex token the collector reads each server's playback ledger with. Falls
# back to PLEX_TOKEN; set it only to hand the monitor a different token. With
# neither set the play history routes answer, but every server reports as
# unreachable with last_error "no_token".
# FM_PLEX_TOKEN=
# How far back the first backfill reaches, in days. Only the first pass on a
# fresh database reads this: after that every pass continues from the last
# play it stored, and nothing is ever pruned.
FM_PLEX_LOOKBACK_DAYS=365
# Library paths whose plays are left out, comma-separated. Unset keeps the
# built-in list (/volume1/Caraxes/tmp); an empty value counts everything.
# FM_PLEX_EXCLUDED_PATHS=/volume1/Caraxes/tmp

# --- 3d. Storage ------------------------------------------------------------
# SQLite file holding metrics and play history. /data is the mounted volume.
# FM_DB_PATH=/data/fleet.db


# ===========================================================================
# 4. Local tooling
# ===========================================================================
# Read on your Mac by the .claude/skills scripts and the bridge's e2e
# scripts. No container reads anything below.

# --- 4a. NAS SSH targets ----------------------------------------------------
# One-off SSH target (user@host) overriding what scripts/nas-host.sh builds
# from FM_SSH_USER and FM_HOST_IPS. WZ_NAS_HOST covers Meleys only; the
# WZ_<HOST>_SSH form covers any host.
# WZ_NAS_HOST=
# WZ_MELEYS_SSH=
# WZ_VERMITHOR_SSH=
# WZ_CARAXES_SSH=
# WZ_SYRAX_SSH=
# WZ_VHAGAR_SSH=

# --- 4b. Live e2e tests -----------------------------------------------------
# The member `bun run test:e2e` signs up and resets. Use an inbox you own;
# passing an email as the first argument overrides it.
# E2E_MEMBER_EMAIL=
# The bridge both e2e suites drive.
# BRIDGE_URL=http://localhost:8000
# test:e2e:tiers only: the server entry tiers share from, and the servers no
# tier may share from (comma-separated).
# SHARE_SERVER=Meleys
# RETIRED_SERVERS=Caraxes
