TZ=America/New_York

# Host user that owns the bind-mounted data folders. On Synology, match this
# to the SSH user's `id` output (rarely 1000) so Wizarr/Tautulli can write.
PUID=1000
PGID=1000

STRIPE_API_KEY=sk_live_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Wizarr runs in the separate "westeroz" project, so use its host-published
# port on the NAS, not compose-network DNS.
WIZARR_BASE_URL=http://192.168.50.2:5690
WIZARR_API_KEY=replace_me
INVITE_EXPIRES_DAYS=7
ACCESS_DURATION=35
MAP_DB_PATH=/data/bridge.db

# Plex owner token, read from plex.tv (not a server) to check who actually holds
# a share. This is ground truth for the admin pages, independent of what Wizarr
# thinks it granted, so leaving it unset silently degrades those checks.
PLEX_TOKEN=replace_me

# Baseline invites: the four per-tier signup links the bridge mints and rotates.
# BASELINE_EXPIRES_DAYS must stay above 1 — at 1 the generations stop
# overlapping and a link shared just before the rotation dies almost at once.
BASELINE_ROTATE_HOUR=3
BASELINE_EXPIRES_DAYS=2

# Admin pages (/manage, /reset-user) auth: the bridge verifies the caller's
# Supabase session (ES256 JWT checked against Supabase's JWKS) and requires an
# allowlisted email. SUPABASE_URL is the project URL; the JWKS + issuer derive
# from it. ADMIN_ALLOWED_ORIGINS are the browser origins allowed to call it (CORS).
SUPABASE_URL=https://<your-project-ref>.supabase.co
ADMIN_ALLOWED_EMAILS=you@example.com
ADMIN_ALLOWED_ORIGINS=http://localhost:5173,https://<your-netlify-site>.netlify.app

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=replace_me
FROM_ADDR=server@example.com
# Public base URL, set once Tailscale Funnel is up (docs/tailscale-funnel.md):
#   PUBLIC_INVITE_BASE=https://<node>.<tailnet>.ts.net
PUBLIC_INVITE_BASE=https://invite.example.com

# Netlify build-time variables (set in the Netlify dashboard, not in this file):
#   VITE_PAYMENT_LINK_BRONZE_URL, VITE_PAYMENT_LINK_SILVER_URL,
#   VITE_PAYMENT_LINK_GOLD_URL, VITE_PAYMENT_LINK_YOUTH_URL, VITE_MEMBER_URL

# ---------------------------------------------------------------------------
# fleet-monitor
# ---------------------------------------------------------------------------
# The monitor authorizes every fleet read off the same Supabase session the
# bridge does. Both values hold what the bridge's SUPABASE_URL and
# ADMIN_ALLOWED_EMAILS hold; they are named apart because the two services read
# their own env, and the monitor prefixes its config FM_.
#
# Leaving either blank does not open the API, it closes it: with the monitor
# published through the Funnel, half-configured has to mean shut.
FM_SUPABASE_URL=https://<project>.supabase.co
FM_ADMIN_ALLOWED_EMAILS=you@example.com

# The unprivileged account the collector ssh-es into all five hosts as.
FM_SSH_USER=crivas
