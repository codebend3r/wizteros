{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["../../.oxlintrc.server.json"],
  "ignorePatterns": ["dist"],
  "overrides": [
    {
      // Vitest reads its config from a default export.
      "files": ["vitest.config.ts"],
      "rules": {
        "import/no-default-export": "off"
      }
    },
    {
      // Operator scripts are CLIs: stdout is the output, and polling a server
      // until it answers is a loop that awaits on purpose.
      "files": ["scripts/**/*.mjs"],
      "rules": {
        "no-console": "off",
        "no-await-in-loop": "off"
      }
    },
    {
      "files": ["src/**/*.test.ts"],
      "rules": {
        "no-console": "off",
        "unicorn/consistent-function-scoping": "off"
      }
    }
  ]
}
