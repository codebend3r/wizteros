{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "fleet-monitor",
  "projectType": "application",
  "sourceRoot": "apps/fleet-monitor/fleet_monitor",
  "tags": ["scope:monitor", "lang:python"],
  "namedInputs": {
    "pyToolchain": [
      {
        "runtime": "apps/fleet-monitor/.venv/bin/ruff --version 2>/dev/null || ruff --version 2>/dev/null || echo 'ruff missing'"
      }
    ]
  },
  "targets": {
    "docker-build": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "docker build -t fleet-monitor apps/fleet-monitor",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
