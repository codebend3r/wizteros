# Stripe Payment Links, one per tier, that the Contribute buttons point at.
# Defaults to the test links in site.config.ts when unset.
VITE_PAYMENT_LINK_BRONZE_URL=
VITE_PAYMENT_LINK_SILVER_URL=
VITE_PAYMENT_LINK_GOLD_URL=
VITE_PAYMENT_LINK_YOUTH_URL=

# Annual Stripe Payment Links, one per tier. These are separate Stripe prices,
# not the monthly ones with a coupon: the cadence toggle swaps the href as well
# as the figure, so a missing link here means the annual button stays hidden
# rather than opening a monthly checkout. Only the hidden /annual preview reads
# them today.
VITE_PAYMENT_LINK_BRONZE_ANNUAL_URL=
VITE_PAYMENT_LINK_SILVER_ANNUAL_URL=
VITE_PAYMENT_LINK_GOLD_ANNUAL_URL=
VITE_PAYMENT_LINK_YOUTH_ANNUAL_URL=

# Wizarr member sign-in URL. Leave unset until Tailscale Funnel is up
# (docs/tailscale-funnel.md) — the member link stays hidden while empty.
# VITE_MEMBER_URL=https://meleys.<tailnet>.ts.net

# Base URL of the stripe-bridge admin API used by /manage and /reset-user.
# Behind Tailscale Funnel, which strips the /stripe prefix before the bridge.
VITE_ADMIN_API_BASE=https://meleys.tail5586d4.ts.net/stripe

# Base URL of the LAN-only fleet-monitor API that the /fleet page renders.
# Required: while unset the call stays relative and collides with this SPA's
# own /fleet route, which the host answers with index.html.
# The port matches the monitor's Dockerfile CMD (uvicorn --port 8010).
# VITE_FLEET_BASE=http://192.168.50.3:8010

# Stripe Customer Portal login link ("Manage or cancel" footer link).
# Activate under Stripe Dashboard > Settings > Billing > Customer portal.
# The footer link stays hidden while unset.
# VITE_BILLING_PORTAL_URL=https://billing.stripe.com/p/login/...

# Supabase Auth for the admin login gate. Both values come from the
# Supabase dashboard (Project Settings > API); the publishable key is safe
# for the public bundle. The login gate is dormant while these are unset.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
