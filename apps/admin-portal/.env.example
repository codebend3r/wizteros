# ===========================================================================
# apps/admin-portal/.env: build-time config for the landing page and admin SPA
# ===========================================================================
#
# Copy this file to .env in this folder for `bun run dev`. .env is
# gitignored; this template is committed, so placeholders only.
#
# Every value here is PUBLIC. Vite inlines each VITE_* variable into the
# JavaScript bundle at build time, so anyone can read them in the browser.
# Never put a secret key here; secrets belong to the servers, in the root .env.
#
# Where production gets them: the Netlify dashboard (Site configuration >
# Environment variables), not this file. A variable missing there silently
# renders nothing (a hidden button, a dead link), so after adding one here,
# add it in Netlify too. Changing one needs a rebuild to take effect.
#
# Sections, in order:
#   1. Server endpoints (the stripe-bridge and fleet-monitor APIs)
#   2. Admin login gate (Supabase)
#   3. Contributions (Stripe payment links and dashboards)
#   4. Member and footer links


# ===========================================================================
# 1. Server endpoints
# ===========================================================================

# Base URL of the stripe-bridge admin API used by /manage, /user and
# /reset-user. Behind Tailscale Funnel, which strips the /stripe prefix
# before the bridge.
VITE_ADMIN_API_BASE=https://<node>.<tailnet>.ts.net/stripe

# Base URL of the fleet-monitor API that the /fleet and /plays pages render.
# Required: while unset the call stays relative and collides with this SPA's
# own /fleet route, which the host answers with index.html.
#
# In production this MUST be the https Funnel mount, not a LAN address. The
# deployed portal is served over https from Netlify, and a browser refuses a
# plain-http subresource as mixed content before it ever leaves the page, so
# no 192.168.x value can work there whatever it is set to. The Funnel strips
# the /monitor prefix, the same way /stripe is stripped for the bridge.
VITE_FLEET_BASE=https://<node>.<tailnet>.ts.net/monitor
# Against a monitor you are running yourself on the LAN, over http, on http:
# VITE_FLEET_BASE=http://<meleys-ip>:8010


# ===========================================================================
# 2. Admin login gate
# ===========================================================================

# Supabase Auth for the admin login. Both values come from the Supabase
# dashboard (Project Settings > API); the publishable key is safe for the
# public bundle. The login gate is dormant while these are unset.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Emails the login gate lets through, comma-separated. Defense in depth only:
# the servers enforce their own allowlist (ADMIN_ALLOWED_EMAILS and
# FM_ADMIN_ALLOWED_EMAILS in the root .env). Unset admits nobody, so the admin
# pages stay locked until it is set.
VITE_ADMIN_ALLOWED_EMAILS=


# ===========================================================================
# 3. Contributions
# ===========================================================================

# Monthly Stripe Payment Links, one per tier, that the Contribute buttons
# point at. A tier whose link is unset shows no button.
VITE_PAYMENT_LINK_BRONZE_URL=
VITE_PAYMENT_LINK_SILVER_URL=
VITE_PAYMENT_LINK_GOLD_URL=
VITE_PAYMENT_LINK_YOUTH_URL=

# Annual Stripe Payment Links, one per tier. These are separate Stripe prices,
# not the monthly ones with a coupon: the cadence toggle swaps the href as well
# as the figure, so a missing link here means the annual button stays hidden
# rather than opening a monthly checkout. Only the hidden /annual preview reads
# them today.
VITE_PAYMENT_LINK_BRONZE_ANNUAL_URL=
VITE_PAYMENT_LINK_SILVER_ANNUAL_URL=
VITE_PAYMENT_LINK_GOLD_ANNUAL_URL=
VITE_PAYMENT_LINK_YOUTH_ANNUAL_URL=

# Stripe Customer Portal login link (the "Manage or cancel" footer link).
# Activate under Stripe Dashboard > Settings > Billing > Customer portal.
# The footer link stays hidden while unset.
# VITE_BILLING_PORTAL_URL=https://billing.stripe.com/p/login/...

# Stripe Dashboard base URL, used to turn a member's customer id into a link
# on /user. Both halves are required to render that row: the member needs a
# customer_id AND this must be set, otherwise the Stripe row falls back to a
# dash for every member. No trailing slash; the app appends /customers/<id>.
VITE_STRIPE_DASHBOARD_URL=https://dashboard.stripe.com


# ===========================================================================
# 4. Member and footer links
# ===========================================================================

# Wizarr member sign-in URL. Leave unset until Tailscale Funnel is up
# (docs/tailscale-funnel.md); the member link stays hidden while empty.
# VITE_MEMBER_URL=https://meleys.<tailnet>.ts.net

# The contact address in the page footer. The link stays hidden while unset.
# Public by design: it is rendered on the landing page.
VITE_CONTACT_EMAIL=
