{
  "name": "admin-portal",
  "version": "0.5.1",
  "private": true,
  "type": "module",
  "scripts": {
    "preinstall": "node ../../scripts/only-bun.mjs",
    "predev": "node ../../scripts/only-bun.mjs",
    "dev": "vite",
    "prebuild": "node ../../scripts/only-bun.mjs",
    "build": "vite build",
    "prepreview": "node ../../scripts/only-bun.mjs",
    "preview": "vite preview",
    "typecheck": "tsgo --noEmit",
    "lint:ts": "oxlint",
    "lint:ts:fix": "oxlint --fix",
    "lint:css": "stylelint \"src/**/*.scss\"",
    "lint:css:fix": "stylelint --fix \"src/**/*.scss\"",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "pretest": "node ../../scripts/only-bun.mjs",
    "test": "bun test --dots --parallel",
    "test:watch": "bun test --dots --parallel --watch"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/doto": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/nunito-sans": "5.3.0",
    "@fontsource/lily-script-one": "5.3.0",
    "@supabase/supabase-js": "2.119.0",
    "@tanstack/query-sync-storage-persister": "5.107.1",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-query-persist-client": "5.107.1",
    "@wizteros/wire": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5",
    "recharts": "3.10.1",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "21.0.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/bun": "1.4.4",
    "@types/node": "catalog:",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native-preview": "catalog:",
    "@vitejs/plugin-react": "6.2.1",
    "happy-dom": "21.0.4",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "sass": "1.108.1",
    "stylelint": "18.0.0",
    "stylelint-config-recommended-scss": "17.0.1",
    "typescript": "7.0.2",
    "vite": "8.3.6"
  },
  "nx": {
    "projectType": "application",
    "tags": [
      "scope:portal",
      "lang:ts"
    ],
    "includedScripts": [
      "dev",
      "build",
      "preview",
      "typecheck",
      "lint:ts",
      "lint:ts:fix",
      "lint:css",
      "lint:css:fix",
      "format",
      "format:check",
      "test",
      "test:watch"
    ],
    "targets": {
      "build": {
        "inputs": [
          "production",
          "^production",
          {
            "runtime": "cat apps/admin-portal/.env apps/admin-portal/.env.* 2>/dev/null; env | grep '^VITE_' | sort; true"
          }
        ]
      }
    }
  }
}
