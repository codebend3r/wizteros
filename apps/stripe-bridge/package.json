{
  "name": "stripe-bridge",
  "version": "0.5.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsgo --noEmit",
    "lint:ts": "oxlint",
    "lint:ts:fix": "oxlint --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node --env-file=../../.env scripts/e2e-retest.mjs",
    "test:e2e:tiers": "node --env-file=../../.env scripts/e2e-tiers.mjs",
    "refresh:libraries": "node --env-file=../../.env scripts/refresh-library-snapshot.mjs"
  },
  "dependencies": {
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-fastify": "catalog:",
    "@wizteros/server-common": "workspace:*",
    "@wizteros/wire": "workspace:*",
    "fast-xml-parser": "5.12.0",
    "nodemailer": "10.3.1",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "stripe": "22.3.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nestjs/cli": "catalog:",
    "@nestjs/testing": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "jose": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:server",
    "vitest": "catalog:"
  },
  "nx": {
    "includedScripts": [
      "build",
      "typecheck",
      "lint:ts",
      "lint:ts:fix",
      "format",
      "format:check",
      "test",
      "test:watch",
      "test:e2e",
      "test:e2e:tiers",
      "refresh:libraries"
    ]
  }
}
