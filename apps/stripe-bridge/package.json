{
  "name": "stripe-bridge",
  "private": true,
  "scripts": {
    "lint:py": "bash scripts/lint-bridge.sh",
    "lint:py:fix": "bash scripts/lint-bridge.sh --fix",
    "test": "bash scripts/test-bridge.sh",
    "test:e2e": "node --env-file=../../.env scripts/e2e-retest.mjs",
    "test:e2e:tiers": "node --env-file=../../.env scripts/e2e-tiers.mjs",
    "refresh:libraries": "node --env-file=../../.env scripts/refresh-library-snapshot.mjs"
  },
  "nx": {
    "includedScripts": [
      "lint:py",
      "lint:py:fix",
      "test",
      "test:e2e",
      "test:e2e:tiers",
      "refresh:libraries"
    ]
  }
}
