{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "stripe-bridge",
  "projectType": "application",
  "sourceRoot": "apps/stripe-bridge/src",
  "tags": ["scope:bridge", "lang:ts"],
  "targets": {
    "docker-build": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "docker build -f apps/stripe-bridge/Dockerfile -t stripe-bridge .",
        "cwd": "{workspaceRoot}"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "commands": [
          "docker rm -f stripe-bridge-e2e >/dev/null 2>&1; docker run -d --name stripe-bridge-e2e -p 8000:8000 --env-file .env -v \"$PWD/apps/stripe-bridge/data:/data\" stripe-bridge"
        ],
        "cwd": "{workspaceRoot}"
      }
    },
    "stop": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "docker rm -f stripe-bridge-e2e",
        "cwd": "{workspaceRoot}"
      }
    },
    "logs": {
      "executor": "nx:run-commands",
      "cache": false,
      "continuous": true,
      "options": {
        "command": "docker logs -f stripe-bridge-e2e",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
