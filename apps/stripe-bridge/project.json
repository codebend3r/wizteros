{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "stripe-bridge",
  "projectType": "application",
  "sourceRoot": "apps/stripe-bridge/stripe_bridge",
  "tags": ["scope:bridge", "lang:python"],
  "namedInputs": {
    "pyToolchain": [
      {
        "runtime": "apps/stripe-bridge/.venv/bin/ruff --version 2>/dev/null || ruff --version 2>/dev/null || echo 'ruff missing'"
      }
    ]
  },
  "targets": {
    "test-docker": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["docker-build"],
      "options": {
        "command": "docker run --rm -v \"$PWD/apps/stripe-bridge:/app\" -w /app stripe-bridge sh -c 'pip install -q pytest responses >/dev/null 2>&1 && python -m pytest -q'",
        "cwd": "{workspaceRoot}"
      }
    },
    "docker-build": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "docker build -t stripe-bridge apps/stripe-bridge",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
