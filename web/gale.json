{
  "extends": "gale:recommended",
  "rules": {
    "scss/at-rule-no-unknown": true,
    "scss/no-duplicate-mixins": true,
    "scss/dollar-variable-pattern": ["error", "^[a-z][a-zA-Z0-9]*$"],
    "no-duplicate-selectors": true,
    "declaration-block-no-duplicate-properties": [
      "error",
      { "ignore": ["consecutive-duplicates-with-different-syntaxes"] }
    ],
    "shorthand-property-no-redundant-values": true,
    "color-hex-length": ["error", "long"],
    "color-named": ["error", "never"],
    "length-zero-no-unit": ["error", { "ignore": ["custom-properties"] }],
    "value-keyword-case": ["error", "lower"],
    "declaration-no-important": "warning",
    "no-descending-specificity": "warning"
  }
}
