# EditorConfig for the Vite + React SPA. https://editorconfig.org
# Values here mirror .oxfmtrc.json so editors and oxfmt agree.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 100

[*.{ts,tsx,js,jsx,mjs,cjs}]
quote_type = single

[*.{scss,css}]
quote_type = single

[*.{json,jsonc,yml,yaml,html}]
max_line_length = off

[*.md]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false
max_line_length = off
