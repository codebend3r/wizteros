# EditorConfig for the FastAPI bridge. https://editorconfig.org
# There is no Python formatter wired up, so max_line_length is a guide for
# editors rather than something a tool enforces.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 100

[*.py]
indent_size = 4

[*.{ini,cfg,toml,json,yml,yaml}]
indent_size = 2

[*.{sh,bash}]
indent_size = 2

[Dockerfile*]
indent_size = 2

[Makefile]
indent_style = tab

[*.md]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false
max_line_length = off
