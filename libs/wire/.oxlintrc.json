{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["../../.oxlintrc.server.json"],
  "ignorePatterns": ["dist"],
  "overrides": [
    {
      // Vitest reads its config from a default export.
      "files": ["vitest.config.ts"],
      "rules": {
        "import/no-default-export": "off"
      }
    }
  ]
}
