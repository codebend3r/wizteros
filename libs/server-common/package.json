{
  "name": "@wizteros/server-common",
  "version": "0.5.2",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsgo --noEmit",
    "lint:ts": "oxlint",
    "lint:ts:fix": "oxlint --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "jose": "catalog:"
  },
  "devDependencies": {
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-fastify": "catalog:",
    "@nestjs/testing": "catalog:",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "typescript": "catalog:server",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@nestjs/common": "catalog:"
  },
  "nx": {
    "projectType": "library",
    "tags": [
      "scope:server",
      "lang:ts"
    ],
    "includedScripts": [
      "build",
      "typecheck",
      "lint:ts",
      "lint:ts:fix",
      "format",
      "format:check",
      "test",
      "test:watch"
    ]
  }
}
