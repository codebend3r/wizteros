{
  "name": "wizteros",
  "version": "0.1.5",
  "private": true,
  "description": "Nx monorepo for the wizteros paid-access stack: the admin-portal SPA and the stripe-bridge API",
  "type": "module",
  "workspaces": ["apps/*"],
  "nx": {
    "includedScripts": []
  },
  "scripts": {
    "preinstall": "node scripts/only-bun.mjs",
    "prepare": "husky",
    "dev": "nx run admin-portal:dev",
    "build": "nx run admin-portal:build",
    "preview": "nx run admin-portal:preview",
    "system-check": "nx run-many -t lint lint:css format:check typecheck test -p admin-portal",
    "verify": "nx run-many -t lint lint:css format:check typecheck test",
    "affected": "nx affected -t lint lint:css format:check typecheck test",
    "graph": "nx graph",
    "typecheck": "nx run admin-portal:typecheck",
    "typecheck:tsc": "nx run-many -t typecheck:tsc -p admin-portal",
    "lint": "nx run admin-portal:lint",
    "lint:fix": "nx run-many -t lint:fix -p admin-portal",
    "lint:css": "nx run-many -t lint:css -p admin-portal",
    "lint:css:fix": "nx run-many -t lint:css:fix -p admin-portal",
    "format": "nx run admin-portal:format",
    "format:check": "nx run-many -t format:check -p admin-portal",
    "setup:py": "python3 -m venv venv && venv/bin/pip install -r apps/stripe-bridge/requirements-dev.txt",
    "test:web": "nx run admin-portal:test",
    "test:bridge": "nx run stripe-bridge:test",
    "test:unit": "nx run stripe-bridge:test-docker",
    "bridge:build": "nx run stripe-bridge:docker-build",
    "bridge:up": "nx run stripe-bridge:serve",
    "bridge:down": "nx run stripe-bridge:stop",
    "bridge:logs": "nx run stripe-bridge:logs",
    "test:e2e": "node --env-file=.env scripts/e2e-retest.mjs",
    "test:e2e:tiers": "node --env-file=.env scripts/e2e-tiers.mjs",
    "refresh:libraries": "node --env-file=.env scripts/refresh-library-snapshot.mjs",
    "retest": "bun run bridge:build && bun run bridge:up && bun run test:e2e",
    "release:patch": "bash scripts/release.sh patch",
    "release:minor": "bash scripts/release.sh minor",
    "release:major": "bash scripts/release.sh major",
    "deploy:nas": "bash scripts/deploy-nas.sh"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "nx": "^23.1.1"
  }
}
