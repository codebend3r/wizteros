{
  "name": "wizteros",
  "version": "0.2.0",
  "private": true,
  "description": "Nx monorepo for the wizteros paid-access stack: the admin-portal SPA and the stripe-bridge API",
  "type": "module",
  "workspaces": ["apps/*"],
  "nx": {
    "includedScripts": []
  },
  "scripts": {
    "preinstall": "node scripts/only-bun.mjs",
    "prepare": "husky",
    "dev": "nx run admin-portal:dev",
    "build": "nx run admin-portal:build",
    "preview": "nx run admin-portal:preview",
    "system-check": "nx run-many -t lint:ts lint:css format:check typecheck test -p admin-portal",
    "verify": "nx run-many -t lint:ts lint:css lint:py format:check typecheck test",
    "affected": "nx affected -t lint:ts lint:css lint:py format:check typecheck test",
    "graph": "nx graph",
    "typecheck": "nx run-many -t typecheck",
    "lint": "nx run-many -t lint:ts lint:css lint:py",
    "lint:fix": "nx run-many -t lint:ts:fix lint:css:fix lint:py:fix",
    "lint:ts": "nx run-many -t lint:ts",
    "lint:ts:fix": "nx run-many -t lint:ts:fix",
    "lint:css": "nx run-many -t lint:css",
    "lint:css:fix": "nx run-many -t lint:css:fix",
    "lint:py": "nx run-many -t lint:py",
    "lint:py:fix": "nx run-many -t lint:py:fix",
    "format": "nx run-many -t format",
    "format:check": "nx run-many -t format:check",
    "setup:py": "python3 -m venv apps/stripe-bridge/.venv && apps/stripe-bridge/.venv/bin/pip install -r apps/stripe-bridge/requirements-dev.txt",
    "test:web": "nx run admin-portal:test",
    "test:bridge": "nx run stripe-bridge:test",
    "test:unit": "nx run stripe-bridge:test-docker",
    "bridge:build": "nx run stripe-bridge:docker-build",
    "bridge:up": "nx run stripe-bridge:serve",
    "bridge:down": "nx run stripe-bridge:stop",
    "bridge:logs": "nx run stripe-bridge:logs",
    "test:e2e": "nx run-many -t test:e2e -p stripe-bridge",
    "test:e2e:tiers": "nx run-many -t test:e2e:tiers -p stripe-bridge",
    "refresh:libraries": "nx run-many -t refresh:libraries -p stripe-bridge",
    "retest": "bun run bridge:build && bun run bridge:up && bun run test:e2e",
    "release:patch": "bash scripts/release.sh patch",
    "release:minor": "bash scripts/release.sh minor",
    "release:major": "bash scripts/release.sh major",
    "release:backfill": "bash scripts/backfill-releases.sh",
    "deploy:nas": "bash scripts/deploy-nas.sh"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "nx": "^23.1.1"
  }
}
