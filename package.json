{
  "name": "wizteros",
  "version": "0.1.4",
  "private": true,
  "description": "Dev/test tooling for the stripe-bridge paid-access stack",
  "type": "module",
  "scripts": {
    "preinstall": "node scripts/only-bun.mjs",
    "prepare": "husky",
    "system-check": "run-s lint lint:css format:check typecheck",
    "typecheck": "bun run --cwd web typecheck",
    "typecheck:tsc": "bun run --cwd web typecheck:tsc",
    "lint": "bun run --cwd web lint",
    "lint:fix": "bun run --cwd web lint:fix",
    "lint:css": "bun run --cwd web lint:css",
    "lint:css:fix": "bun run --cwd web lint:css:fix",
    "format": "bun run --cwd web format",
    "format:check": "bun run --cwd web format:check",
    "setup:py": "python3 -m venv venv && venv/bin/pip install -r stripe-bridge/requirements-dev.txt",
    "test:web": "bun run --cwd web test",
    "test:bridge": "bash scripts/test-bridge.sh",
    "verify": "run-s system-check test:web test:bridge",
    "bridge:build": "docker build -t stripe-bridge ./stripe-bridge",
    "bridge:up": "docker rm -f stripe-bridge-e2e >/dev/null 2>&1; docker run -d --name stripe-bridge-e2e -p 8000:8000 --env-file .env -v \"$PWD/stripe-bridge/data:/data\" stripe-bridge",
    "bridge:down": "docker rm -f stripe-bridge-e2e",
    "bridge:logs": "docker logs -f stripe-bridge-e2e",
    "test:unit": "docker run --rm -v \"$PWD/stripe-bridge:/app\" -w /app stripe-bridge sh -c 'pip install -q pytest responses >/dev/null 2>&1 && python -m pytest -q'",
    "test:e2e": "node --env-file=.env scripts/e2e-retest.mjs",
    "retest": "run-s bridge:build bridge:up test:e2e",
    "release:patch": "bash scripts/release.sh patch",
    "release:minor": "bash scripts/release.sh minor",
    "release:major": "bash scripts/release.sh major",
    "deploy:nas": "bash scripts/deploy-nas.sh"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "npm-run-all2": "^9.0.2"
  }
}
